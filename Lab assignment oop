class account{
   private int balance;
   private int withdraww;
   private int deposit;

   public account(){
       balance=23000;
       withdraww=10000;
       deposit=14000;
   }
   public account(int b,int w,int d){
       balance=b;
       withdraww=w;
       deposit=d;
   }
   public void display(){
       System.out.println("your balance is:"+balance);
   }
   public int withdraw(){
      return (balance=balance-withdraww);
   }
   public int deposited(){
      return (balance=deposit+balance);
   }
}
public class accounts{
    public static void main(String[] args){
        account A1=new account();
        A1.display();
        System.out.println(A1.withdraw());
        System.out.println(A1.deposited());
    }

}

