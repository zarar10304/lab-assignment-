class distance{
   private int feet;
   private int inches;

   public distance(){
       feet=25;
       inches=300;
   }
   public distance(int f,int i){
       feet=f;
       inches=i;
   }
   public void display(){
       System.out.println("distance in feets:"+feet+"\n"+"inches:"+inches);
   }
   public int inch(){
       return (feet*12);
   }
   public int feets(){
       return (inches/12);
   }
}
public class distances{
    public static void main(String[] args){
        distance D1=new distance();
        System.out.println(D1.feets());
        System.out.println(D1.inch());
        D1.display();

    }
}

